generator client {
  provider = "prisma-client-js"
}

// This schema is the database contract. The application services use these
// models through repositories; changing a model normally requires a migration.

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  categories   Category[]
  transactions Transaction[]
  budgets      Budget[]
  monthlyBudgets MonthlyBudget[]
}

model Category {
  id          String        @id @default(cuid())
  userId      String
  name        String
  type        TransactionType
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  budgets     Budget[]

  @@unique([userId, name])
}

model Transaction {
  id              String          @id @default(cuid())
  userId          String
  categoryId      String
  amount          Decimal         @db.Decimal(12, 2)
  type            TransactionType
  description     String
  transactionDate DateTime
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  category        Category        @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@index([userId, transactionDate])
}

model Budget {
  id        String   @id @default(cuid())
  userId    String
  categoryId String
  month     Int
  year      Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category  Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([userId, categoryId, month, year])
}

model MonthlyBudget {
  id            String   @id @default(cuid())
  userId        String
  month         Int
  year          Int
  incomeTarget  Decimal  @default(0) @db.Decimal(12, 2)
  savingsTarget Decimal  @default(0) @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
}

enum TransactionType {
  INCOME
  EXPENSE
}
